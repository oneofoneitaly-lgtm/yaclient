{
  "name": "ya-client-launcher",
  "productName": "YA CLIENT",
  "version": "1.0.47",
  "description": "Launcher ufficiale di YA CLIENT (Minecraft 1.8.9)",
  "main": "main.js",
  "author": "YA",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.1",
    "msmc": "^5.0.0",
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "dev.yaclient.launcher",
    "productName": "YA CLIENT",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "YA CLIENT",
      "runAfterFinish": true
    },
    "artifactName": "YA-CLIENT-Setup.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "config.json",
      "content.json",
      "mods.json",
      "renderer/**/*",
      "assets/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "adrianmaftean09-commits",
        "repo": "yaclient"
      }
    ]
  }
}